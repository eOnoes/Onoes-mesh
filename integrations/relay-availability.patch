+"""Read-only exact-task recovery of A2A availability; never dispatch or settle sends."""
+import asyncio
+import hashlib
+import json
+import re
+from datetime import datetime, timezone
+
+TERMINAL = {"TASK_STATE_COMPLETED": "done", "TASK_STATE_FAILED": "stopped",
+            "TASK_STATE_CANCELED": "stopped", "TASK_STATE_REJECTED": "stopped"}
+
+def waiting_source(store, agent_id, conversation_id):
+    # The newest row in this conversation wins even if unresolved: do not skip
+    # newer work to make an older completed task appear current.
+    row = next((r for r in store.outbox_recent(agent_id, limit=500)
+                if r.get("session_id") == conversation_id), None)
+    if not row or row.get("agent_id") != agent_id or row.get("state") != "accepted":
+        return None
+    ref = row.get("transport_ref") or ""
+    if not ref.startswith("a2a:") or not re.fullmatch(r"[A-Za-z0-9_-]{1,100}", ref[4:]):
+        return None
+    if row.get("attachments") not in (None, "", "[]") or not isinstance(row.get("content"), str):
+        return None
+    return row
+
+def native_proof(task, row):
+    if not isinstance(task, dict) or task.get("id") != row["transport_ref"][4:] or task.get("contextId") != row["session_id"]:
+        return None
+    state = (task.get("status") or {}).get("state")
+    if state not in TERMINAL:
+        return None
+    users=[]
+    for msg in task.get("history") or []:
+        if msg.get("role") != 1 and str(msg.get("role", "")).lower() not in ("user", "role_user"):
+            continue
+        parts=[]
+        for p in msg.get("parts") or []:
+            text=p.get("text")
+            if not isinstance(text,str):
+                c=p.get("content") or {}
+                text=c.get("value") if c.get("$case")=="text" else None
+            if isinstance(text,str):parts.append(text)
+        users.append("".join(parts))
+    if users.count(row["content"]) != 1:
+        return None
+    payload_hash=hashlib.sha256(row["content"].encode()).hexdigest()
+    proof={"taskId":task["id"],"contextId":task["contextId"],"sendId":row["idem_key"],
+           "state":state,"payloadHash":payload_hash,"nativeAt":(task.get("status") or {}).get("timestamp")}
+    proof["proofHash"]=hashlib.sha256(json.dumps(proof,sort_keys=True,separators=(",",":")).encode()).hexdigest()
+    proof["verifiedAt"]=datetime.now(timezone.utc).isoformat()
+    return proof
+
+async def reconcile_waiting(agent, store, read_task, apply):
+    def idle_waiting():
+        return agent.is_a2a and agent.status=="waiting" and not agent.running() and not agent.message_queue and not agent.approval
+    if not idle_waiting():return False
+    context=agent.conversation_id
+    row=waiting_source(store,agent.id,context)
+    if not row:return False
+    try:
+        task=await asyncio.wait_for(read_task(row["transport_ref"][4:]),timeout=3)
+    except Exception:
+        return False
+    try:proof=native_proof(task,row)
+    except (TypeError,ValueError,AttributeError,KeyError):return False
+    if not proof or not idle_waiting() or agent.conversation_id!=context:
+        return False
+    # No await after the second admission check: a new local run cannot sneak
+    # between verification and applying the exact old outcome.
+    if waiting_source(store,agent.id,context)!=row:return False
+    apply(agent,task,proof,TERMINAL[proof["state"]])
+    return True
