@@ -6,6 +6,20 @@ export function backlogEligibility(task,at=Date.now()){
  // Failure reconciliation belongs to the original claim, never to fresh intake.
  if(task.flow?.claim||task.flow?.state&&task.flow.state!=='idea')return {eligible:false,reason:'Already claimed or waiting for clarification'};
  if(task.automation?.state==='active')return {eligible:false,reason:'Team active'};
- if(task.messages.some(m=>m.phase==='work'&&['prepared','unknown','accepted'].includes(m.state)&&!m.outcome&&!task.agentUpdates.some(u=>u.sendId===m.id&&u.applied)))return {eligible:false,reason:'Unresolved original worker'};
+ if(task.messages.some(m=>m.phase==='work'&&['prepared','unknown','accepted'].includes(m.state)))return {eligible:false,reason:'Writer quiescence is unproven'};
  return {eligible:true,reason:'Unassigned idea older than twelve hours'};
 }
+
+// A terminal task/run status does not prove that tools, subagents, or child
+// processes have ended. Current Workroom receipts carry no positive quiescence
+// proof, so every accepted/prepared/uncertain writer send remains a blocker.
+export function writerQuiescenceBlockers(tasks){
+ const blockers=[];
+ for(const task of tasks){
+  if(task.automation?.state==='active')blockers.push({taskId:task.id,sendId:'',state:'active',reason:'active_team'});
+  for(const message of task.messages||[]){
+   if(message.phase==='work'&&['prepared','unknown','accepted'].includes(message.state))blockers.push({taskId:task.id,sendId:message.id,state:message.state,reason:'writer_quiescence_unproven'});
+  }
+ }
+ return blockers;
+}
